{
  "id": "../apps/contacts.html",
  "name": "Suchi — Contacts · Samvit",
  "short_name": "Suchi",
  "description": "An address book in Samvit, running entirely on your device.",
  "start_url": "../apps/contacts.html",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "background_color": "#f2f3f6",
  "theme_color": "#f2f3f6",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "../icons/doc-contacts-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-contacts-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-contacts-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-contacts-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/doc-contacts-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Address Book",
      "short_name": "Contacts",
      "description": "Start a new address book",
      "url": "../apps/contacts.html?new=1",
      "icons": [
        {
          "src": "../icons/doc-contacts-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "../apps/contacts.html",
      "name": "Samvit Contacts",
      "accept": {
        "application/x-officesuite-contacts": [
          ".oscontacts"
        ],
        "text/vcard": [
          ".vcf",
          ".vcard"
        ]
      },
      "icons": [
        {
          "src": "../icons/doc-contacts-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "../apps/contacts.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/vcard",
            "text/csv",
            ".oscontacts",
            ".vcf",
            ".vcard",
            ".csv"
          ]
        }
      ]
    }
  }
}
