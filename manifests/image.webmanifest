{
  "id": "../apps/image.html",
  "name": "Chitra — Pictures · Samvit",
  "short_name": "Chitra",
  "description": "Pictures in Samvit, running entirely on your device.",
  "start_url": "../apps/image.html",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "background_color": "#f2f3f6",
  "theme_color": "#f2f3f6",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "graphics",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "../icons/doc-image-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-image-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-image-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-image-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/doc-image-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Picture",
      "short_name": "Picture",
      "description": "Start a new Chitra picture",
      "url": "../apps/image.html?new=1",
      "icons": [
        {
          "src": "../icons/doc-image-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "../apps/image.html",
      "name": "Samvit Picture",
      "accept": {
        "application/x-officesuite-image": [
          ".osimage"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ]
      },
      "icons": [
        {
          "src": "../icons/doc-image-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "../apps/image.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            ".osimage",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".gif"
          ]
        }
      ]
    }
  }
}
