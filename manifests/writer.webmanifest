{
  "id": "../apps/writer.html",
  "name": "Lekha — Documents · Samvit",
  "short_name": "Lekha",
  "description": "Documents in Samvit, running entirely on your device.",
  "start_url": "../apps/writer.html",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "background_color": "#f2f3f6",
  "theme_color": "#f2f3f6",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "../icons/doc-writer-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-writer-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-writer-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-writer-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/doc-writer-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Document",
      "short_name": "Document",
      "description": "Start a new Writer document",
      "url": "../apps/writer.html?new=1",
      "icons": [
        {
          "src": "../icons/doc-writer-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "../apps/writer.html",
      "name": "Lekha document",
      "accept": {
        "application/x-officesuite-writer": [
          ".oswriter"
        ]
      },
      "icons": [
        {
          "src": "../icons/doc-writer-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "../apps/writer.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            "text/markdown",
            ".oswriter",
            ".txt",
            ".md"
          ]
        }
      ]
    }
  }
}
