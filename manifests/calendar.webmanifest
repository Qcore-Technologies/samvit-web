{
  "id": "../apps/calendar.html",
  "name": "Tithi — Calendar · Samvit",
  "short_name": "Tithi",
  "description": "A calendar and task planner in Samvit, running entirely on your device.",
  "start_url": "../apps/calendar.html",
  "scope": "../",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "browser"
  ],
  "background_color": "#f2f3f6",
  "theme_color": "#f2f3f6",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "../icons/doc-calendar-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-calendar-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-calendar-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/doc-calendar-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "../icons/doc-calendar-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Calendar",
      "short_name": "Calendar",
      "description": "Start a new calendar",
      "url": "../apps/calendar.html?new=1",
      "icons": [
        {
          "src": "../icons/doc-calendar-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "../apps/calendar.html",
      "name": "Samvit Calendar",
      "accept": {
        "application/x-officesuite-calendar": [
          ".oscalendar"
        ],
        "text/calendar": [
          ".ics"
        ]
      },
      "icons": [
        {
          "src": "../icons/doc-calendar-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "../apps/calendar.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/calendar",
            ".oscalendar",
            ".ics"
          ]
        }
      ]
    }
  }
}
