      "purpose": "any"
    },
    {
      "src": "icons/icon-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-167.png",
      "sizes": "167x167",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Document",
      "short_name": "Lekha",
      "description": "Start a new Writer document",
      "url": "apps/writer.html?new=1",
      "icons": [
        {
          "src": "icons/doc-writer-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Spreadsheet",
      "short_name": "Anka",
      "description": "Start a new Sheets spreadsheet",
      "url": "apps/sheets.html?new=1",
      "icons": [
        {
          "src": "icons/doc-sheet-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Presentation",
      "short_name": "Darsha",
      "description": "Start a new Slides deck",
      "url": "apps/slides.html?new=1",
      "icons": [
        {
          "src": "icons/doc-slides-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Drawing",
      "short_name": "Rekha",
      "description": "Start a new Draw canvas",
      "url": "apps/draw.html?new=1",
      "icons": [
        {
          "src": "icons/doc-draw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Database",
      "short_name": "Kosha",
      "description": "Start a new Base database",
      "url": "apps/base.html?new=1",
      "icons": [
        {
          "src": "icons/doc-base-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Notebook",
      "short_name": "Smriti",
      "description": "Start a new Notes notebook",
      "url": "apps/notes.html?new=1",
      "icons": [
        {
          "src": "icons/doc-notes-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Address Book",
      "short_name": "Suchi",
      "description": "Start a new address book",
      "url": "apps/contacts.html?new=1",
      "icons": [
        {
          "src": "icons/doc-contacts-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Calendar",
      "short_name": "Tithi",
      "description": "Start a new calendar",
      "url": "apps/calendar.html?new=1",
      "icons": [
        {
          "src": "icons/doc-calendar-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Open a PDF",
      "short_name": "Syra",
      "description": "Open a PDF file from this device",
      "url": "apps/pdf.html?new=1",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Meeting",
      "short_name": "Sabha",
      "description": "Start a new Sabha meeting",
      "url": "apps/meet.html?new=1",
      "icons": [
        {
          "src": "icons/doc-meet-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Picture",
      "short_name": "Chitra",
      "description": "Start a new Chitra picture",
      "url": "apps/image.html?new=1",
      "icons": [
        {
          "src": "icons/doc-image-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Form",
      "short_name": "Prashna",
      "description": "Start a new Prashna form",
      "url": "apps/forms.html?new=1",
      "icons": [
        {
          "src": "icons/doc-forms-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "New Design",
      "short_name": "Rachana",
      "description": "Start a new Rachana design",
      "url": "apps/design.html?new=1",
      "icons": [
        {
          "src": "icons/doc-design-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
