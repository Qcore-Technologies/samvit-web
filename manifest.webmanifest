  "file_handlers": [
    {
      "action": "apps/writer.html",
      "name": "Lekha document",
      "accept": {
        "application/x-officesuite-writer": [
          ".oswriter"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-writer-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/sheets.html",
      "name": "Samvit Spreadsheet",
      "accept": {
        "application/x-officesuite-sheet": [
          ".ossheet"
        ],
        "text/csv": [
          ".csv"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-sheet-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/slides.html",
      "name": "Samvit Presentation",
      "accept": {
        "application/x-officesuite-slides": [
          ".osslides"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-slides-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/draw.html",
      "name": "Samvit Drawing",
      "accept": {
        "application/x-officesuite-draw": [
          ".osdraw"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-draw-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/base.html",
      "name": "Samvit Database",
      "accept": {
        "application/x-officesuite-base": [
          ".osbase"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-base-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/notes.html",
      "name": "Samvit Notebook",
      "accept": {
        "application/x-officesuite-notes": [
          ".osnotes"
        ],
        "text/markdown": [
          ".md"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-notes-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/contacts.html",
      "name": "Samvit Contacts",
      "accept": {
        "application/x-officesuite-contacts": [
          ".oscontacts"
        ],
        "text/vcard": [
          ".vcf",
          ".vcard"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-contacts-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/image.html",
      "name": "Samvit Picture",
      "accept": {
        "application/x-officesuite-image": [
          ".osimage"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-image-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "index.html",
      "name": "Samvit Data",
      "accept": {
        "application/json": [
          ".json"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/calendar.html",
      "name": "Samvit Calendar",
      "accept": {
        "application/x-officesuite-calendar": [
          ".oscalendar"
        ],
        "text/calendar": [
          ".ics"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-calendar-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/pdf.html",
      "name": "PDF document",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "application/x-officesuite-pdf": [
          ".ospdf"
        ]
      },
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/meet.html",
      "name": "Samvit Meeting",
      "accept": {
        "application/x-officesuite-meet": [
          ".osmeet"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-meet-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/forms.html",
      "name": "Samvit Form",
      "accept": {
        "application/x-officesuite-forms": [
          ".osforms"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-forms-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "apps/design.html",
      "name": "Samvit Design",
      "accept": {
        "application/x-officesuite-design": [
          ".osdesign"
        ]
      },
      "icons": [
        {
          "src": "icons/doc-design-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "text/plain",
            "text/markdown",
            "text/csv",
            "application/json",
            ".oswriter",
            ".ossheet",
            ".osslides",
            ".osdraw",
            ".osbase",
            ".osnotes",
            ".md",
            ".txt",
            ".csv",
            ".json",
            "text/vcard",
            ".oscontacts",
            ".vcf",
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            ".osimage",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".gif"
          ]
        }
      ]
    }
  }
}
